# ==============================================================================
# JARVIS AI Assistant - Environment Configuration Template
# Copy this file to .env and set your personal credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Google Gemini API Configuration (Required for live AI reasoning)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
# Recommended options: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Assistant Persona
JARVIS_NAME=JARVIS
USER_NAME=Sir

# System Capabilities (Toggles for Phase progression)
VOICE_ENABLED=false
VISION_ENABLED=false
GESTURE_ENABLED=false
WEB_HUD_ENABLED=false

# Security & Permissions (Levels 0 to 4)
# 0 = Safe, 1 = Low Risk, 2 = Moderate, 3 = High Risk, 4 = Critical
PERMISSION_CONFIRMATION_THRESHOLD=3

# Observability & Logging
LOG_LEVEL=INFO
DEBUG=false
